# Скопируйте этот файл в .env и укажите свои значения

# Подключение к PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=metal_market
DB_PASSWORD=
DB_NAME=metal_market

# Папки относительно корня проекта или абсолютные пути:
# датасет в CSV и результаты (модели, прогнозы, выборки для обучения)
DATASET_DIR=data
OUTPUT_DIR=output

# REST API: адрес и порт (python -m sales_analytics.api)
API_HOST=127.0.0.1
API_PORT=8000
